{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafia-game",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mafia.tannerwj.com", "custom_domain": true }],
  // Spec 15 (AI narrator): Workers AI binding. Test/dev never hit the real
  // model — pool-workers + wrangler dev use STORYTELLER_FAKE (see
  // vitest.workers.config.ts / .dev.vars); production calls are host-gated
  // and rate-limited in the DO.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "STORYTELLER_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
