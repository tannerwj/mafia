{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafia-game",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mafia.tannerwj.com", "custom_domain": true }],
  // Spec 15 (AI narrator): Workers AI binding. Test/dev never hit the real
  // model — pool-workers + wrangler dev use STORYTELLER_FAKE (see
  // vitest.workers.config.ts / .dev.vars); production calls are host-gated
  // and rate-limited in the DO.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "STORYTELLER_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Spec 16 D3: the Worker must see `/room/:code` GET requests (to rewrite
    // per-room OG/robots meta) before the assets layer serves the SPA
    // fallback HTML for them. Every other path keeps today's asset-first
    // routing untouched.
    // "/api/*" must be listed too: once run_worker_first is an explicit list,
    // the dev asset layer answers unlisted non-asset paths itself (a POST to
    // /api/rooms got a static 405 instead of the worker — 2026-07-06).
    "run_worker_first": ["/room/*", "/api/*"],
    // The Cloudflare Vite plugin doesn't need this (it points `dev`/`build`
    // at the client build output itself) — but `vitest-pool-workers` loads
    // this file directly with no Vite involvement, so `env.ASSETS` needs an
    // explicit directory to serve from. Means `dist/client` must exist
    // (`vite build`) before the `server` test project's D3 tests can pass;
    // see 16-implementation-notes.md.
    "directory": "dist/client"
  },
  // Spec 17: every trace captured (traffic is tiny; default is also 1 but
  // we pin it so a future template change can't silently sample us down).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Spec 17: metrics dataset — writeDataPoint is fire-and-forget and code
  // must no-op safely when the binding is absent (tests).
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "mafia_metrics" }
  ]
}
